{
  "name": "lumen-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lumen Atlas — 可在网页与 Vision Pro 上浏览的 3D 效果画廊",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build-thumbnails.mjs --check && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173 --host",
    "verify": "node scripts/verify-scenes.mjs",
    "verify:viewer": "node scripts/verify-viewer.mjs",
    "verify:experience": "node scripts/verify-experience.mjs",
    "thumbnails:build": "node scripts/build-thumbnails.mjs",
    "thumbnails:check": "node scripts/build-thumbnails.mjs --check"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.12.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
